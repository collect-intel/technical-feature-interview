{
  "name": "technical-feature-interview",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "next dev",
    "doctor": "node --disable-warning=ExperimentalWarning scripts/doctor.ts",
    "scenario": "node scripts/scenario.ts",
    "reset": "node scripts/reset.ts",
    "test": "node --disable-warning=ExperimentalWarning --test --test-concurrency=1 \"tests/**/*.test.ts\"",
    "test:given": "node --disable-warning=ExperimentalWarning --test --test-concurrency=1 \"tests/given/*.test.ts\"",
    "test:known-answer": "node --disable-warning=ExperimentalWarning --test --test-concurrency=1 \"tests/known-answer/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "build": "next build",
    "start": "next start"
  },
  "dependencies": {
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "typescript": "^5.6.3"
  }
}
